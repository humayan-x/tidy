# Maintainer: tidy contributors <contributors@tidy.org>
pkgname=tidy-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="A blazing-fast, zero-dependency, local-first file organizer and watcher in Rust"
arch=('x86_64')
url="https://github.com/humayan-x/tidy"
license=('MIT' 'Apache-2.0')
depends=()
makedepends=()
source_x86_64=("https://github.com/humayan-x/tidy/releases/download/v${pkgver}/tidy-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')

package() {
    cd "${srcdir}/tidy-v${pkgver}-x86_64-unknown-linux-musl"

    # Install binary
    install -Dm755 tidy "${pkgdir}/usr/bin/tidy"

    # Install systemd user service unit
    install -Dm644 templates/tidy.service "${pkgdir}/usr/lib/systemd/user/tidy.service"

    # Install shell completions using the binary
    install -d "${pkgdir}/usr/share/bash-completion/completions"
    install -d "${pkgdir}/usr/share/zsh/site-functions"
    install -d "${pkgdir}/usr/share/fish/vendor_completions.d"

    "${srcdir}/tidy-v${pkgver}-x86_64-unknown-linux-musl/tidy" completions bash > "${pkgdir}/usr/share/bash-completion/completions/tidy"
    "${srcdir}/tidy-v${pkgver}-x86_64-unknown-linux-musl/tidy" completions zsh  > "${pkgdir}/usr/share/zsh/site-functions/_tidy"
    "${srcdir}/tidy-v${pkgver}-x86_64-unknown-linux-musl/tidy" completions fish > "${pkgdir}/usr/share/fish/vendor_completions.d/tidy.fish"

    # Install documentation
    install -Dm644 README.md "${pkgdir}/usr/share/doc/tidy/README.md"
}
