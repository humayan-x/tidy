---
import { Icon } from 'astro-icon/components';
---

<footer class="mt-auto border-t border-line-default bg-surface-root">
  <div class="mx-auto max-w-7xl px-3.5 py-10 sm:px-6 sm:py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Col 1: Brand & Bio -->
      <div class="space-y-3 md:col-span-2">
        <div class="flex items-center gap-2">
          <Icon name="tabler:terminal-2" class="w-5 h-5 text-primary shrink-0" />
          <span class="font-mono text-base font-bold tracking-tight text-title">tidy</span>
          <span class="font-mono text-xs text-dim">
            v0.2.0
          </span>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted">
          A blazing-fast, zero-dependency, local-first file organizer and watcher in Rust for Linux and macOS. Non-destructive by design with transactional SQLite rollback.
        </p>
        <div class="flex flex-wrap items-center gap-2 pt-1 text-xs font-mono text-dim">
          <span>Rust 1.75+</span>
          <span>•</span>
          <span>Dual MIT / Apache-2.0</span>
          <span>•</span>
          <span>~3–5 MB RSS</span>
        </div>
      </div>

      <!-- Col 2: Commands & CLI -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-body">
          Commands
        </h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted font-mono">
          <li class="py-0.5">tidy run</li>
          <li class="py-0.5">tidy watch</li>
          <li class="py-0.5">tidy undo</li>
          <li class="py-0.5">tidy status</li>
          <li class="py-0.5">tidy service</li>
        </ul>
      </div>

      <!-- Col 3: Resources & Distribution -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-body">
          Distribution
        </h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          <li>
            <a
              href="https://github.com/humayan-x/tidy"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-title transition-colors flex items-center gap-1.5 py-0.5"
            >
              <Icon name="tabler:brand-github" class="w-4 h-4 text-dim shrink-0" />
              <span>GitHub Repository</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.npmjs.com/package/@humayan-x/tidy"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-title transition-colors block py-0.5"
            >
              npm: @humayan-x/tidy
            </a>
          </li>
          <li>
            <a
              href="https://github.com/humayan-x/tidy/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-title transition-colors block py-0.5"
            >
              Binary Releases
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 sm:mt-10 border-t border-line-subtle pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-dim text-center sm:text-left">
      <p>© {new Date().getFullYear()} tidy contributors. Released under MIT or Apache-2.0 License.</p>
      <p class="font-mono text-dim">
        Engineered with zero runtime dependencies.
      </p>
    </div>
  </div>
</footer>
