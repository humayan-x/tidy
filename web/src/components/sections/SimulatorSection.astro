---
import OrganizerSimulator from '../interactive/OrganizerSimulator';
import { Icon } from 'astro-icon/components';
---

<section id="demo" class="border-b border-line-default bg-surface-root py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-3 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 sm:gap-4 pb-4 sm:pb-6 border-b border-line-subtle">
      <div>
        <div class="inline-flex items-center gap-1.5 font-mono text-xs text-primary">
          <Icon name="tabler:terminal-2" class="w-3.5 h-3.5 text-primary" />
          <span>Interactive Sandbox</span>
        </div>
        <h2 class="mt-1.5 sm:mt-2 text-xl font-bold tracking-tight text-title sm:text-3xl">
          Organization & Rollback Demo
        </h2>
      </div>
      <div class="font-mono text-[11px] sm:text-xs text-muted">
        Non-destructive collision renaming • SQLite undo journal
      </div>
    </div>

    <!-- SolidJS Interactive Client Component -->
    <div class="mt-6 sm:mt-8">
      <OrganizerSimulator client:visible />
    </div>
  </div>
</section>
