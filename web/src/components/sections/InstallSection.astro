---
import InstallTabs from '../interactive/InstallTabs';
import { Icon } from 'astro-icon/components';
---

<section id="install" class="bg-surface-root py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-3 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 sm:pb-6 border-b border-line-subtle">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-primary">
          Distribution
        </span>
        <h2 class="mt-1.5 sm:mt-2 text-xl font-bold tracking-tight text-title sm:text-3xl">
          Installation & Commands
        </h2>
      </div>
      <div class="font-mono text-[11px] sm:text-xs text-muted">
        Linux (x86_64, aarch64) • macOS (Apple Silicon, Intel)
      </div>
    </div>

    <!-- Interactive SolidJS Install Tabs -->
    <div class="mt-6 sm:mt-8 max-w-4xl mx-auto">
      <InstallTabs client:visible />
    </div>

    <!-- Commands Cheat Sheet & Daemon Grid -->
    <div class="mt-8 sm:mt-10 grid grid-cols-1 lg:grid-cols-2 gap-4">
      
      <!-- CLI Command Reference -->
      <div class="rounded border border-line-default bg-surface-card p-3.5 sm:p-5 flex flex-col justify-between">
        <div class="flex items-center gap-2 border-b border-line-subtle pb-3">
          <Icon name="tabler:terminal-2" class="w-4 h-4 text-primary" />
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-title">
            CLI Commands
          </h3>
        </div>
        <div class="mt-3 divide-y divide-line-subtle font-mono text-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <code class="text-title font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy run --dry-run</code>
            <span class="text-muted text-[11px]">Preview without moving</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <code class="text-title font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy run --recursive</code>
            <span class="text-muted text-[11px]">Scan subfolders recursively</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <code class="text-title font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy watch --initial-scan</code>
            <span class="text-muted text-[11px]">Initial pass + kernel watcher</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <code class="text-title font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy undo</code>
            <span class="text-muted text-[11px]">Revert last batch</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <code class="text-title font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy undo --last 3</code>
            <span class="text-muted text-[11px]">Revert last 3 batches</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <code class="text-title font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy status</code>
            <span class="text-muted text-[11px]">Report DB and rules</span>
          </div>
        </div>
      </div>

      <!-- Native OS Background Service -->
      <div class="rounded border border-line-default bg-surface-card p-3.5 sm:p-5 flex flex-col justify-between">
        <div class="flex items-center gap-2 border-b border-line-subtle pb-3">
          <Icon name="tabler:server" class="w-4 h-4 text-primary" />
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-title">
            Background Service (systemd / launchd)
          </h3>
        </div>

        <div class="mt-3 divide-y divide-line-subtle font-mono text-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <span class="text-muted text-[11px]">Enable & start on boot:</span>
            <code class="text-primary font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy service enable</code>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <span class="text-muted text-[11px]">Check service status:</span>
            <code class="text-primary font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy service status</code>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <span class="text-muted text-[11px]">Follow live daemon logs:</span>
            <code class="text-primary font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy service logs -f</code>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 py-2">
            <span class="text-muted text-[11px]">Stop & disable daemon:</span>
            <code class="text-muted font-semibold text-[11px] sm:text-xs whitespace-nowrap overflow-x-auto no-scrollbar touch-scroll">$ tidy service disable</code>
          </div>
        </div>
      </div>

    </div>

    <!-- Shell Auto-completions -->
    <div class="mt-6 rounded border border-line-default bg-surface-card p-4 sm:p-5">
      <div class="flex items-center gap-2 mb-3 border-b border-line-subtle pb-3">
        <Icon name="tabler:file-text" class="w-4 h-4 text-muted" />
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-title">
          Shell Completions
        </span>
      </div>

      <div class="divide-y divide-line-subtle font-mono text-xs">
        <div class="py-2.5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 overflow-x-auto no-scrollbar touch-scroll">
          <span class="font-mono text-xs font-semibold text-primary shrink-0 w-12">
            Bash
          </span>
          <code class="text-body text-[11px] sm:text-xs whitespace-nowrap select-all">
            tidy completions bash &gt; ~/.local/share/bash-completion/completions/tidy
          </code>
        </div>
        <div class="py-2.5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 overflow-x-auto no-scrollbar touch-scroll">
          <span class="font-mono text-xs font-semibold text-primary shrink-0 w-12">
            Zsh
          </span>
          <code class="text-body text-[11px] sm:text-xs whitespace-nowrap select-all">
            tidy completions zsh &gt; ~/.zsh/completion/_tidy
          </code>
        </div>
        <div class="py-2.5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 overflow-x-auto no-scrollbar touch-scroll">
          <span class="font-mono text-xs font-semibold text-primary shrink-0 w-12">
            Fish
          </span>
          <code class="text-body text-[11px] sm:text-xs whitespace-nowrap select-all">
            tidy completions fish &gt; ~/.config/fish/completions/tidy.fish
          </code>
        </div>
      </div>
    </div>

  </div>
</section>
