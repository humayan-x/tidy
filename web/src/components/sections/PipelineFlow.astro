---
import { Icon } from 'astro-icon/components';

const STAGES = [
  {
    step: '01',
    name: 'Event Trigger',
    type: 'Input',
    desc: 'inotify (Linux) / FSEvents (macOS) event or manual CLI trigger.',
    detail: '2000ms debounce',
  },
  {
    step: '02',
    name: 'Download Guard',
    type: 'Filter',
    desc: 'Bypasses active browser downloads (.crdownload, .part, .aria2).',
    detail: 'In-progress safety',
  },
  {
    step: '03',
    name: 'Stability Filter',
    type: 'Lock',
    desc: 'Samples file size across intervals and queries advisory OS locks.',
    detail: '500ms write tick',
  },
  {
    step: '04',
    name: 'MIME Classifier',
    type: 'Parser',
    desc: 'Matches compound extensions (.tar.gz) with magic-byte fallback.',
    detail: '70+ file formats',
  },
  {
    step: '05',
    name: 'Category Routing',
    type: 'Routing',
    desc: 'Maps file to structured directory hierarchy (e.g. Documents/PDF).',
    detail: 'Ext-nested folders',
  },
  {
    step: '06',
    name: 'Collision Handler',
    type: 'Safety',
    desc: 'Appends incremental counter (file (1).ext) if name already exists.',
    detail: 'Never overwrites',
  },
  {
    step: '07',
    name: 'Atomic Mover',
    type: 'I/O',
    desc: 'Fast atomic rename with staged verify-unlink fallback across disks.',
    detail: 'EXDEV cross-device',
  },
  {
    step: '08',
    name: 'SQLite Journal',
    type: 'Ledger',
    desc: 'Commits batch transaction into history.db for immediate undo.',
    detail: 'WAL mode commit',
  },
];
---

<section id="pipeline" class="border-b border-line-default bg-surface-root py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-3 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 sm:pb-6 border-b border-line-subtle">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-primary">
          Architecture
        </span>
        <h2 class="mt-1.5 sm:mt-2 text-xl font-bold tracking-tight text-title sm:text-3xl">
          Execution Pipeline
        </h2>
      </div>
      <div class="font-mono text-[11px] sm:text-xs text-muted">
        8 verification gates prior to filesystem mutation
      </div>
    </div>

    <!-- 8-Step Grid Flow -->
    <div class="mt-6 sm:mt-8 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
      {
        STAGES.map((stage) => (
          <div class="rounded border border-line-default bg-surface-card p-4 relative flex flex-col justify-between hover:border-line-strong transition-colors">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-primary">
                  {stage.step}
                </span>
                <span class="font-mono text-[11px] text-dim">
                  {stage.type}
                </span>
              </div>
              <h3 class="mt-2 font-mono text-xs font-semibold text-title">
                {stage.name}
              </h3>
              <p class="mt-1 text-xs text-muted leading-snug">
                {stage.desc}
              </p>
            </div>
            <div class="mt-3 border-t border-line-subtle pt-2 font-mono text-[10px] text-dim">
              {stage.detail}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Pipeline Safety Callouts (Clean, unboxed) -->
    <div class="mt-8 pt-6 border-t border-line-subtle grid grid-cols-1 md:grid-cols-3 gap-6 text-xs font-mono">
      <div class="space-y-1">
        <div class="text-title font-semibold flex items-center gap-1.5">
          <Icon name="tabler:shield-check" class="w-3.5 h-3.5 text-primary" />
          <span>EXDEV Copy-Verify</span>
        </div>
        <p class="text-muted text-[11px] leading-relaxed">
          Verifies size and checksum before deleting source across disk partitions.
        </p>
      </div>
      <div class="space-y-1">
        <div class="text-title font-semibold flex items-center gap-1.5">
          <Icon name="tabler:cpu" class="w-3.5 h-3.5 text-primary" />
          <span>Symlink Isolation</span>
        </div>
        <p class="text-muted text-[11px] leading-relaxed">
          Never traverses directory symlinks targeting outside the watch root.
        </p>
      </div>
      <div class="space-y-1">
        <div class="text-title font-semibold flex items-center gap-1.5">
          <Icon name="tabler:history" class="w-3.5 h-3.5 text-primary" />
          <span>Atomic Ledger</span>
        </div>
        <p class="text-muted text-[11px] leading-relaxed">
          Immediate WAL journal writes guarantee zero orphaned files during undo.
        </p>
      </div>
    </div>
  </div>
</section>
