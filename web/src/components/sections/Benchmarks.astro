---
import { Icon } from 'astro-icon/components';
---

<section id="benchmarks" class="border-b border-zinc-800 bg-zinc-950 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-6 border-b border-zinc-850">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
          Benchmarks
        </span>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">
          Resource Footprint
        </h2>
      </div>
      <div class="font-mono text-xs text-zinc-400">
        Measured on Linux 6.8 x86_64, idle background watcher
      </div>
    </div>

    <!-- Comparative Table -->
    <div class="mt-8 overflow-x-auto rounded border border-zinc-800 bg-zinc-900">
      <table class="w-full text-left font-mono text-xs">
        <thead>
          <tr class="border-b border-zinc-800 bg-zinc-950 text-zinc-400 whitespace-nowrap">
            <th class="py-3 px-4 font-medium">Metric</th>
            <th class="py-3 px-4 font-medium text-cyan-400">tidy (Rust)</th>
            <th class="py-3 px-4 font-medium text-zinc-400">Python (Watchdog)</th>
            <th class="py-3 px-4 font-medium text-zinc-400">Node.js (Chokidar)</th>
            <th class="py-3 px-4 font-medium text-zinc-400">Shell Script</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800/60 whitespace-nowrap">
          <tr class="hover:bg-zinc-850/50 transition-colors">
            <td class="py-3 px-4 font-medium text-zinc-200">Idle Memory (RSS)</td>
            <td class="py-3 px-4 text-cyan-300 font-semibold bg-cyan-950/20">~3.5 MB</td>
            <td class="py-3 px-4 text-zinc-400">~45–60 MB</td>
            <td class="py-3 px-4 text-zinc-400">~65–90 MB</td>
            <td class="py-3 px-4 text-zinc-400">~15 MB</td>
          </tr>
          <tr class="hover:bg-zinc-850/50 transition-colors">
            <td class="py-3 px-4 font-medium text-zinc-200">Startup Latency</td>
            <td class="py-3 px-4 text-cyan-300 font-semibold bg-cyan-950/20">&lt; 2 ms</td>
            <td class="py-3 px-4 text-zinc-400">140 ms</td>
            <td class="py-3 px-4 text-zinc-400">220 ms</td>
            <td class="py-3 px-4 text-zinc-400">12 ms</td>
          </tr>
          <tr class="hover:bg-zinc-850/50 transition-colors">
            <td class="py-3 px-4 font-medium text-zinc-200">Binary Size / Runtime</td>
            <td class="py-3 px-4 text-cyan-300 font-semibold bg-cyan-950/20">&lt; 4.8 MB (Static)</td>
            <td class="py-3 px-4 text-zinc-400">Python runtime (~80MB)</td>
            <td class="py-3 px-4 text-zinc-400">Node runtime (~120MB)</td>
            <td class="py-3 px-4 text-zinc-400">Bash + coreutils</td>
          </tr>
          <tr class="hover:bg-zinc-850/50 transition-colors">
            <td class="py-3 px-4 font-medium text-zinc-200">Background CPU Idle</td>
            <td class="py-3 px-4 text-cyan-300 font-semibold bg-cyan-950/20">&lt; 0.05%</td>
            <td class="py-3 px-4 text-zinc-400">~1.2%</td>
            <td class="py-3 px-4 text-zinc-400">~1.6%</td>
            <td class="py-3 px-4 text-zinc-400">~0.5%</td>
          </tr>
          <tr class="hover:bg-zinc-850/50 transition-colors">
            <td class="py-3 px-4 font-medium text-zinc-200">Transactional Undo</td>
            <td class="py-3 px-4 text-cyan-300 font-semibold bg-cyan-950/20">SQLite Ledger</td>
            <td class="py-3 px-4 text-zinc-500">None</td>
            <td class="py-3 px-4 text-zinc-500">None</td>
            <td class="py-3 px-4 text-zinc-500">None</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
