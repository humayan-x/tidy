---
import { Icon } from 'astro-icon/components';
---

<section class="relative border-b border-line-default bg-surface-root py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">
      
      <!-- Top Release Status (Clean, unboxed) -->
      <div class="inline-flex items-center gap-2 font-mono text-xs text-muted">
        <span class="flex h-2 w-2 rounded-full bg-primary"></span>
        <span class="text-body">tidy v0.2.0</span>
        <span class="text-dim">/</span>
        <span class="text-muted">Rust 1.75+</span>
      </div>

      <!-- Main Headline -->
      <h1 class="mt-5 max-w-4xl text-2xl xs:text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-title leading-tight">
        Fast, non-destructive file organizer & watcher in Rust
      </h1>

      <!-- Concise Subtitle -->
      <p class="mt-3 sm:mt-4 max-w-2xl text-sm sm:text-lg text-muted px-2">
        Organize cluttered folders into clean directory trees with collision safety and instant SQLite rollback.
      </p>

      <!-- Action Buttons -->
      <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row w-full sm:w-auto items-center justify-center gap-2.5 sm:gap-3 px-4">
        <a
          href="https://github.com/humayan-x/tidy"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded border border-line-strong bg-surface-card px-5 py-2.5 text-sm font-medium text-title transition-colors hover:border-line-strong hover:bg-surface-subtle hover:text-title"
        >
          <Icon name="tabler:brand-github" class="w-4 h-4 text-muted" />
          <span>Star on GitHub</span>
        </a>

        <a
          href="#install"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded border border-line-default bg-surface-card px-5 py-2.5 text-sm font-mono text-muted transition-colors hover:border-line-strong hover:text-title"
        >
          <Icon name="tabler:terminal-2" class="w-4 h-4 text-primary" />
          <span>Install CLI</span>
        </a>
      </div>

      <!-- Quick Command Bar: Wide container, guaranteed single-line display -->
      <div class="mt-6 sm:mt-8 w-full max-w-2xl sm:max-w-3xl px-2 sm:px-0">
        <div class="flex items-center justify-between gap-2.5 sm:gap-4 rounded border border-line-default bg-surface-card px-3 py-2 sm:px-4 sm:py-3 font-mono text-[11px] xs:text-xs sm:text-sm text-body shadow-inner">
          <div class="flex items-center gap-2 sm:gap-3 overflow-x-auto no-scrollbar touch-scroll py-0.5 text-left">
            <span class="text-primary select-none">$</span>
            <span class="text-title select-all whitespace-nowrap">
              npx @humayan-x/tidy run --path ~/Downloads --dry-run
            </span>
          </div>
          <button
            id="copy-hero-btn"
            class="flex items-center gap-1.5 rounded border border-line-strong bg-surface-elevated px-2.5 py-1 text-xs text-body transition-colors hover:bg-surface-hover hover:text-title shrink-0 select-none min-h-[30px]"
            title="Copy command"
            onclick="navigator.clipboard.writeText('npx @humayan-x/tidy run --path ~/Downloads --dry-run'); this.querySelector('.copy-txt').textContent = 'Copied'; setTimeout(() => this.querySelector('.copy-txt').textContent = 'Copy', 2000);"
          >
            <Icon name="tabler:copy" class="w-3.5 h-3.5 text-muted" />
            <span class="copy-txt">Copy</span>
          </button>
        </div>
      </div>

      <!-- Architectural Spec Badges (Clean, unboxed) -->
      <div class="mt-10 sm:mt-14 grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-6 w-full max-w-3xl border-t border-line-subtle pt-8 px-2 sm:px-0">
        <div class="text-left">
          <div class="flex items-center gap-1.5 sm:gap-2 text-muted">
            <Icon name="tabler:cpu" class="w-4 h-4 text-muted shrink-0" />
            <span class="font-mono text-xs sm:text-sm font-semibold text-title truncate">&lt; 5 MB</span>
          </div>
          <p class="mt-1 text-[11px] sm:text-xs text-dim">Static binary</p>
        </div>

        <div class="text-left">
          <div class="flex items-center gap-1.5 sm:gap-2 text-muted">
            <Icon name="tabler:bolt" class="w-4 h-4 text-primary shrink-0" />
            <span class="font-mono text-xs sm:text-sm font-semibold text-title truncate">~3–5 MB</span>
          </div>
          <p class="mt-1 text-[11px] sm:text-xs text-dim">Idle RSS memory</p>
        </div>

        <div class="text-left">
          <div class="flex items-center gap-1.5 sm:gap-2 text-muted">
            <Icon name="tabler:history" class="w-4 h-4 text-muted shrink-0" />
            <span class="font-mono text-xs sm:text-sm font-semibold text-title truncate">SQLite Ledger</span>
          </div>
          <p class="mt-1 text-[11px] sm:text-xs text-dim">Instant batch undo</p>
        </div>

        <div class="text-left">
          <div class="flex items-center gap-1.5 sm:gap-2 text-muted">
            <Icon name="tabler:shield-check" class="w-4 h-4 text-primary shrink-0" />
            <span class="font-mono text-xs sm:text-sm font-semibold text-title truncate">Non-Destructive</span>
          </div>
          <p class="mt-1 text-[11px] sm:text-xs text-dim">Zero overwrites</p>
        </div>
      </div>

    </div>
  </div>
</section>
