---
import ConfigExplorer from '../interactive/ConfigExplorer';
import { Icon } from 'astro-icon/components';
---

<section id="config" class="border-b border-line-default bg-surface-root py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-3 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 sm:pb-6 border-b border-line-subtle">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-primary">
          Rules & TOML
        </span>
        <h2 class="mt-1.5 sm:mt-2 text-xl font-bold tracking-tight text-title sm:text-3xl">
          Zero-Config Defaults, Fully Extensible
        </h2>
      </div>
      <div class="font-mono text-[11px] sm:text-xs text-muted">
        Overridable in ~/.config/tidy/config.toml
      </div>
    </div>

    <!-- SolidJS Interactive Explorer (Widened) -->
    <div class="mt-6 sm:mt-8">
      <ConfigExplorer client:visible />
    </div>

    <!-- Scaffolding Hint -->
    <div class="mt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 border-t border-line-subtle pt-4 text-xs font-mono text-muted">
      <span>Scaffold default configuration:</span>
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar touch-scroll w-full sm:w-auto">
        <code class="text-primary font-semibold whitespace-nowrap">
          tidy init
        </code>
        <span class="text-dim text-[11px] whitespace-nowrap">→ ~/.config/tidy/config.toml</span>
      </div>
    </div>
  </div>
</section>
