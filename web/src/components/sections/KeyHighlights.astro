---
import { Icon } from 'astro-icon/components';

const HIGHLIGHTS = [
  {
    iconName: 'tabler:bolt',
    title: 'Native Rust Binary',
    tag: '< 5 MB Static',
    description: 'Compiled with LTO and zero runtime dependencies for sub-millisecond dispatch.',
    codeSnippet: 'cargo build --release',
  },
  {
    iconName: 'tabler:shield-check',
    title: 'Non-Destructive Operations',
    tag: 'Zero Overwrites',
    description: 'Automatic incremental collision renaming (e.g. photo (1).jpg) and symlink barriers.',
    codeSnippet: 'name (1).pdf',
  },
  {
    iconName: 'tabler:history',
    title: 'Transactional Undo',
    tag: 'SQLite Ledger',
    description: 'Every file move is journaled into local history.db for immediate single or batch rollbacks.',
    codeSnippet: 'tidy undo --last 3',
  },
  {
    iconName: 'tabler:eye',
    title: '70+ Formats Classifier',
    tag: 'MIME & Compound',
    description: 'Native handling for compound archives (.tar.gz) and magic-byte MIME fallback.',
    codeSnippet: 'compound .tar.gz',
  },
  {
    iconName: 'tabler:cpu',
    title: 'Adaptive Kernel Watcher',
    tag: '~3–5 MB RSS',
    description: 'inotify and FSEvents hooks with download guards that ignore in-progress files.',
    codeSnippet: 'tidy watch --debounce 2000',
  },
  {
    iconName: 'tabler:server',
    title: 'Native OS Daemon',
    tag: 'systemd & launchd',
    description: 'Manage persistent background watching via systemd --user (Linux) or launchd (macOS).',
    codeSnippet: 'tidy service enable',
  },
];
---

<section id="features" class="border-b border-line-default bg-surface-root py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-3 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 sm:pb-6 border-b border-line-subtle">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-primary">
          Core Engine
        </span>
        <h2 class="mt-1.5 sm:mt-2 text-xl font-bold tracking-tight text-title sm:text-3xl">
          Engineered for Safety & Speed
        </h2>
      </div>
      <div class="font-mono text-[11px] sm:text-xs text-muted">
        Rust 2021 • Zero runtime dependencies • SQLite WAL
      </div>
    </div>

    <div class="mt-6 sm:mt-8 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {
        HIGHLIGHTS.map((item) => (
          <div class="flex flex-col justify-between rounded border border-line-default bg-surface-card p-4 sm:p-5 transition-colors hover:border-line-strong">
            <div>
              <div class="flex items-center justify-between">
                <Icon name={item.iconName} class="w-5 h-5 text-primary shrink-0" />
                <span class="font-mono text-[11px] text-dim">
                  {item.tag}
                </span>
              </div>

              <h3 class="mt-3 font-mono text-sm font-semibold text-title">
                {item.title}
              </h3>
              <p class="mt-1.5 text-xs text-muted leading-normal">
                {item.description}
              </p>
            </div>

            <div class="mt-4 border-t border-line-subtle pt-2.5">
              <div class="flex items-center justify-between font-mono text-[11px]">
                <span class="text-dim">CLI:</span>
                <code class="text-body font-mono text-xs">
                  {item.codeSnippet}
                </code>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
