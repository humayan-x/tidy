---
import { Icon } from 'astro-icon/components';
---

<header class="sticky top-0 z-50 w-full border-b border-line-default/80 bg-surface-root/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Logo (Clean, unboxed) -->
    <a href="#" class="flex items-center gap-2 group">
      <Icon name="tabler:terminal-2" class="w-5 h-5 text-primary shrink-0" />
      <span class="font-mono text-base font-semibold tracking-tight text-title group-hover:text-primary transition-colors">
        tidy
      </span>
      <span class="font-mono text-xs text-dim">
        v0.2.1
      </span>
    </a>

    <!-- Header Actions (GitHub - Clean text link, unboxed) -->
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/humayan-x/tidy"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-title transition-colors"
        aria-label="GitHub Repository"
      >
        <Icon name="tabler:brand-github" class="w-4 h-4 text-muted" />
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
