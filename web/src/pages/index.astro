---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/sections/Hero.astro';
import SimulatorSection from '../components/sections/SimulatorSection.astro';
import KeyHighlights from '../components/sections/KeyHighlights.astro';
import PipelineFlow from '../components/sections/PipelineFlow.astro';
import Benchmarks from '../components/sections/Benchmarks.astro';
import ConfigSection from '../components/sections/ConfigSection.astro';
import QuickstartSection from '../components/sections/QuickstartSection.astro';
import InstallSection from '../components/sections/InstallSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="flex-1">
    <Hero />
    <SimulatorSection />
    <KeyHighlights />
    <PipelineFlow />
    <Benchmarks />
    <ConfigSection />
    <QuickstartSection />
    <InstallSection />
  </main>
  <Footer />
</Layout>
