---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "tidy - Blazing-Fast Local File Organizer & Watcher in Rust",
  description = "A blazing-fast, zero-dependency, local-first file organizer and watcher in Rust for Linux and macOS. Guaranteed non-destructive operations with SQLite undo ledger.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Developer Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface-root text-title min-h-screen flex flex-col font-sans antialiased selection:bg-surface-elevated selection:text-title overflow-x-hidden">
    <slot />
  </body>
</html>
